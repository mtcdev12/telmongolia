# Copy this file to .env.local and keep the real key only on the server.
# Gemini is selected automatically when GEMINI_API_KEY is present.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-flash-latest

# Public site origin used by the server-side knowledge crawler.
# Production example: https://www.example.mn
SITE_CRAWL_ORIGIN=http://127.0.0.1:3000

# Number-order Express API origin. Keep this server-side only.
# Local example: http://127.0.0.1:3001
NUMBER_ORDER_API_ORIGIN=

# Optional live telecom service connectors. Leave blank until the
# corresponding authenticated organization API is available.
TELECOM_OUTAGE_API_URL=
TELECOM_BILLING_API_URL=
TELECOM_TICKET_API_URL=
TELECOM_APPOINTMENT_API_URL=
TELECOM_HANDOFF_API_URL=
TELECOM_INTEGRATION_TOKEN=

# Private assistant analytics dashboard (/assistant-admin).
# Use a long random value in production. No message or personal data is stored.
CHAT_ADMIN_KEY=
# Optional absolute JSONL file path. Defaults to .data/assistant-events.jsonl.
CHAT_ANALYTICS_PATH=

# Optional OpenAI fallback:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
