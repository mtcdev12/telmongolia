TITLE="Монголын Цахилгаан Холбоо ХК"
BASEURL='http://localhost:3000'
API='https://api.telecommongolia.mn'
API2='https://api2.telecommongolia.mn/v1'
DESC='Official website of Telecom Mongolia'
MYSQL_HOST= 127.0.0.1
MYSQL_PORT= 3306
MYSQL_DATABASE= tvroom
MYSQL_USER= root
MYSQL_PASSWORD=

# Egune AI chatbot (server-side secrets only)
AI_PROVIDER=egune
EGUNE_API_KEY=
EGUNE_BASE_URL=https://api.egune.com/v1
EGUNE_MODEL=egune-mid

# Chimege speech integration
CHIMEGE_TOKEN=
CHIMEGE_VOICE=FEMALE3v2
NEXT_PUBLIC_CHIMEGE_STT_ENABLED=false
NEXT_PUBLIC_CHIMEGE_TTS_ENABLED=false

# LIME webview link verification (server-side only; never use a NEXT_PUBLIC_ prefix)
LIME_WEBVIEW_SECRET=
# Optional: LIME_WEBVIEW_ALG=ed25519 with LIME_WEBVIEW_PUBLIC_KEY (PEM or base64) instead of the HMAC secret
LIME_WEBVIEW_ALG=
LIME_WEBVIEW_PUBLIC_KEY=

# LIME service callback after a confirmed MIP70 payment (server-side only)
LIME_SERVICE_URL=
PAYMENT_CALLBACK_TOKEN=

# LIME -> us: token LIME sends to POST /api/mip70/link (server-to-server)
LIME_LINK_API_TOKEN=
# Public origin used in issued links (falls back to BASEURL), e.g. https://telecommongolia.mn
LIME_LINK_BASE_URL=
